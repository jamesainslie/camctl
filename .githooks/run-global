#!/bin/sh
# usage: .githooks/run-global HOOK [ARGS...]
#
# The repository's hooksPath hides any global one (core.hooksPath in the
# global git config), so each hook here ends by running the global hook of
# the same name, when there is one.
set -eu
hook="$1"
shift
global="$(git config --global --type=path --get core.hooksPath || true)"
if [ -n "${global}" ] && [ -x "${global}/${hook}" ]; then
  exec "${global}/${hook}" "$@"
fi
